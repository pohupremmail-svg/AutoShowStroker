<Project Sdk="Microsoft.NET.Sdk">

  <!-- The app's logic, data and formats. Deliberately no reference to Godot: everything in here
       is tested with plain `dotnet test`, and the engine project is the only thing that knows
       about scenes, audio and the screen. -->
