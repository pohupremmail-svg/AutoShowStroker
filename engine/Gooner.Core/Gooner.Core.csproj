    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Gooner.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gooner.Core.Tests" />
  </ItemGroup>

</Project>
