<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the release package and checks it (see Program.cs for how to run it). Only ever
       builds: it never talks to GitHub or anything else, so anyone who clones the repo can run it
       to build their own copy. A developer tool; it ships with nothing. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Gooner.Build</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gooner.Build.Tests" />
  </ItemGroup>

</Project>
